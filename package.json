{
  "name": "scrape-heal",
  "version": "0.1.0",
  "description": "A self-healing web scraper: detects when a site's markup breaks its selectors, then repairs them with a verify-then-ship loop.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "scrape-heal": "./dist/cli.js"
  },
  "files": [
    "dist",
    "fixture"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Swastikbhat-lab/scrape-heal.git"
  },
  "homepage": "https://github.com/Swastikbhat-lab/scrape-heal",
  "bugs": {
    "url": "https://github.com/Swastikbhat-lab/scrape-heal/issues"
  },
  "keywords": [
    "scraper",
    "self-healing",
    "web-scraping",
    "playwright",
    "watchdog",
    "selectors",
    "css-selectors",
    "repair"
  ],
  "author": "Swastik Bhat <s.bhat@gwu.edu>",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "demo": "tsx src/demo.ts",
    "demo:any": "tsx src/demo-any.ts",
    "demo:llm": "tsx src/cli.ts --demo --mutate-values 6 --interval 5 --cycles 8 --llm-mock @llm-proposal.json",
    "demo:validator": "tsx src/cli.ts --demo --mutate 8 --interval 5 --cycles 6 --validator fixture/validator.js",
    "init": "tsx src/cli.ts --init",
    "watch": "tsx src/cli.ts",
    "test": "tsx --test test/validate.test.ts test/parse.test.ts test/proposal.test.ts test/ledger.test.ts test/config.test.ts test/llm-memory.test.ts test/heal.test.ts",
    "typecheck": "tsc --noEmit",
    "make:gif": "node scripts/make-demo-gif.mjs",
    "make:gifs": "node scripts/make-demo-gif.mjs && node scripts/make-watchdog-gif.mjs"
  },
  "dependencies": {
    "playwright": "^1.49.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "gifenc": "^1.0.3",
    "pngjs": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
